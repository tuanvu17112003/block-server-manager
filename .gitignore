# Dependencies
node_modules/

# Build output
dist/

# Local app data (servers, caches, backups, test artefacts). Never committed: it holds real user state and can be tens
# of gigabytes. The `.bak-*` form covers a renamed data root kept for inspection during an investigation.
.app-data/
.app-data.bak-*/

# Local caches / indexes (regenerable)
.codegraph/

# OS / editor
.DS_Store
Thumbs.db
*.local

# Archived Tauri tree build output/codegen (regenerable; not part of the shipped app)
legacy/src-tauri/target/
legacy/src-tauri/gen/

# Tooling node_modules (nested-only; do NOT ignore bare .opencode/ - skills/ is source)
.opencode/node_modules/

# Additional build output (regenerable)
dist-ssr/
*.tsbuildinfo

# Logs (do NOT ignore package-lock.json)
*.log
.opencode/*.log
logs/

# Vendored skills (user-approved 2026-10-08: stay on disk, untracked)
.opencode/skills/

#Codex skills
.agents

# AI-agent local state (never commit)
.commandcode/

# electron dev data root
.app-data/
dist-electron/
# curseforge api key (never commit)
.app-data/curseforge-key.txt
# Google OAuth credentials and tokens: never commit either. The client id/secret are read from the data root or
# env at runtime, and the refresh token is the user's own credential.
.app-data/google-oauth.json
.app-data/gdrive-tokens.enc
.app-data/gdrive-tokens.json
.e2e.out

# verification artifacts
artifacts/

# packaged output (NSIS installer + win-unpacked; distributed as release artifacts, not committed)
release/


# Internal workflow/investigation artifacts (not part of the app)
.workflow/

# ------------------------------------------------------------------------------------------------
# Removed from GitHub on purpose (2026-10-30), still present on the developer's disk.
#
# Rationale: these are historical artefacts — the archived Tauri/Rust tree, pre-Electron planning documents,
# the research corpus those plans were built from, UI screenshots from a superseded phase, regenerable logs, and
# a testing evaluation written for the Tauri architecture that ADR-0020 retired. They add repository weight
# without helping anyone read or run the app. They were untracked with `git rm --cached`, so a clone no longer
# carries them and no working tree lost anything.
#
# NOT ignored here, because the verification gate reads them at runtime — a fresh clone must still pass
# `npm run verify`: docs/research/2026-10-29-universal-modpack-install.md,
# docs/research/2026-10-29-p1c-format-census.md, docs/research/2026-10-29-claim-verification.md,
# docs/audit/23-synthesis-correct-design.md, docs/audit/24-deviations-register.md, and the two real-artefact
# inputs docs/evidence/adapters/prism-real-instance.zip + atl-real-instance.json.
# ------------------------------------------------------------------------------------------------
legacy/
tester/
# docs/research/ is ignored file-by-file rather than by directory. Git cannot re-include a file whose parent directory
# is excluded, so a `docs/research/` rule plus `!` exceptions does not work — the exceptions are silently ineffective.
# Listing the directory's contents explicitly keeps the intent visible and lets the gate inputs stay tracked.
docs/research/*
# The three documents the conformance gate parses at runtime. C1 compares every format in
# 2026-10-29-universal-modpack-install.md §2 against the registered adapters, so removing it breaks the gate.
!docs/research/2026-10-29-universal-modpack-install.md
!docs/research/2026-10-29-p1c-format-census.md
!docs/research/2026-10-29-claim-verification.md
# ...and documents that are live design input rather than historical record. The test is "would deleting this lose
# reasoning we still act on?" — not "does it have 'research' in the path".
!docs/research/2026-10-30-public-server-access.md
docs/implementation/
docs/evidence/phase8-ui/
docs/README.md
docs/electron-port-plan.md
docs/electron-completion-plan-summary.md
docs/evidence/*.log
docs/evidence/*.gz
docs/evidence/*.jsonl

