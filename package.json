{
  "name": "mc-server-manager",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Desktop Minecraft server manager — install Modrinth, CurseForge and FTB modpacks, then run and operate the servers. Electron + TypeScript + React.",
  "author": "Block Server Manager contributors",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:1420 && cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron .\"",
    "dev:web": "vite",
    "build": "npm run build:electron && tsc && vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/copy-installer-data.mjs && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build:web": "tsc && vite build",
    "start": "npm run build && electron .",
    "pack:dir": "npm run build && electron-builder --dir --win",
    "pack:win": "npm run build && electron-builder --win nsis",
    "pack:verify": "node scripts/verify-package.mjs",
    "pack:verify:installer": "node scripts/verify-installer.mjs",
    "selftest": "npm run build:electron && electron . --selftest",
    "mgmttest": "npm run build:electron && electron . --mgmttest",
    "ipctest": "npm run build && electron . --ipctest",
    "test:unit": "npm run build:electron && node scripts/unit.mjs",
    "test:contract": "npm run build:electron && node node_modules/electron/cli.js . --contracttest",
    "test:services": "npm run build:electron && node node_modules/electron/cli.js . --servicestest",
    "test:lifecycle": "npm run build:electron && node node_modules/electron/cli.js . --lifetest",
    "test:ui": "npm run build && node node_modules/electron/cli.js . --uitest --artifacts=artifacts/ui",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^6.4.5",
    "wait-on": "^8.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuanvu17112003/block-server-manager.git"
  },
  "homepage": "https://github.com/tuanvu17112003/block-server-manager#readme",
  "bugs": {
    "url": "https://github.com/tuanvu17112003/block-server-manager/issues"
  },
  "keywords": [
    "minecraft",
    "minecraft-server",
    "server-manager",
    "modpack",
    "modrinth",
    "curseforge",
    "fabric",
    "forge",
    "neoforge",
    "electron",
    "typescript",
    "react",
    "desktop-app",
    "windows"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "win32"
  ]
}
